datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

enum CarStatus {
  Entregue
  Pendente
  Processando
}

enum FuelType {
  Gasolina
  Alcool
  Flex
  Diesel
  Hibrido
  Eletrico
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  cpf       String     @unique
  cep       String
  password  String
  number    String?
  active    Boolean    @default(true)
  
  avatarUrl String?    @map("avatar_url")
  
  garages   Garage[]
  favorites Favorite[]
  testDrives TestDrive[]
  @@map("User")
}

model Car {
  id              String    @id @default(uuid())
  name            String
  model           String
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])
  value           Decimal   @db.Decimal(10, 2)
  status          CarStatus @default(Processando)
  date_registered DateTime  @default(now())

  // Chaves Estrangeiras Físicas
  brandId String
  especId String @unique
  itensId String @unique

  // O 'onDelete: Cascade' apaga a ficha técnica se o carro for deletado
  brand Brand @relation(fields: [brandId], references: [id])
  espec Espec @relation(fields: [especId], references: [id], onDelete: Cascade)
  itens Itens @relation(fields: [itensId], references: [id], onDelete: Cascade)

  images    Image[]
  garages   Garage[]
  favorites Favorite[]
  testDrives TestDrive[]
}

model Brand {
  id   String @id @default(uuid())
  name String @unique
  cars Car[]
}

model Itens {
  id               String  @id @default(uuid())
  airbag           Boolean @default(false)
  alarm            Boolean @default(false)
  leather_seat     Boolean @default(false)
  cruise_control   Boolean @default(false)
  abs              Boolean @default(false)
  onBoard_computer Boolean @default(false)

  car Car? // Relação 1:1 inversa
}

model Espec {
  id           String   @id @default(uuid())
  year         Int
  fuel         FuelType @default(Gasolina)
  color        String
  transmission String
  engine       String
  potency      String
  max_speed    String

  car Car? // Relação 1:1 inversa
}

model Image {
  id    String @id @default(uuid())
  url   String
  carId String
  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  cars Car[]
}

model Garage {
  id         String   @id @default(uuid())
  date_offer DateTime @default(now())

  offeredValue Decimal @db.Decimal(10, 2)
  message      String? @db.Text
  carImageUrl  String?

  status ProposalStatus @default(Pendente)

  carId  String
  userId String

  car  Car  @relation(fields: [carId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([userId, carId, status])
}

model Favorite {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  message   String?  @db.Text

  userId String
  carId  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  car  Car  @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([userId, carId])
}

enum ProposalStatus {
  Pendente // Usuário enviou, aguardando admin
  EmAnalise // Admin visualizou e está avaliando
  Aceita // Proposta aprovada
  Recusada // Proposta negada
  ContraProposta // Admin sugeriu outro valor
}


enum TestDriveStatus {
  Pendente
  Confirmado
  Cancelado
  Realizado
}

model TestDrive {
  id          String          @id @default(uuid())
  scheduledAt DateTime
  carId       String
  userId      String
  message     String?
  status      TestDriveStatus @default(Pendente) // <- ADICIONE ESTA LINHA

  car         Car             @relation(fields: [carId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, carId, scheduledAt])
}